# 必須
OIDC_ISSUER=https://example.com
OIDC_AUDIENCE=s3
STS_ENDPOINT=https://s3.example.com
STS_ROLE_ARN=arn:aws:iam::000000000000:role/image
S3_ENDPOINT=https://s3.example.com
ALLOWED_BUCKETS=images

# 任意（既定値）
LISTEN_ADDR=:8080
S3_REGION=us-east-1
S3_PATH_STYLE_ACCESS=true
STS_ROLE_SESSION_NAME=s3-image-resizer
STS_DURATION_SECONDS=900
MAX_SOURCE_BYTES=52428800
MAX_SOURCE_PIXELS=60000000
MAX_CONCURRENCY=2
REQUEST_TIMEOUT=60s
